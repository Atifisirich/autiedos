{
  "name": "autoed-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:reset": "node scripts/db.mjs reset && pnpm --filter @autoed/server seed",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "pnpm --filter @autoed/server seed",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "node scripts/build-i18n.mjs && node scripts/check-i18n.mjs",
    "dev": "pnpm --filter @autoed/web dev",
    "i18n:build": "node scripts/build-i18n.mjs",
    "db:reset:platform": "node scripts/db.mjs reset --platform-only",
    "test:platform": "pnpm --filter @autoed/server test:platform",
    "test:crm": "pnpm --filter @autoed/crm-server test:db"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.2"
    }
  }
}
