# --- Required -------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres   # Supabase pooled connection string in production
DATABASE_SSL=false                                                    # true for Supabase
AUTH_JWT_SECRET=change-me-to-a-long-random-string                     # signs OS session tokens
STORAGE_SIGNING_SECRET=change-me-too                                  # signs local file URLs (dev/local storage)
CRON_SECRET=change-me-three                                           # Vercel cron calls /api/cron/tick with this

# --- Supabase (production auth and storage) --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Sign-in mode ---------------------------------------------------------------------------
# Leave these unset in production. "dev" allows email-only sign-in for demos and tests.
AUTH_PROVIDER=
NEXT_PUBLIC_AUTH_PROVIDER=

# --- AI: Google Gemini only (DECISIONS #40). Blocked on Atif: a Gemini API key on a PAID tier. ---
# Development and tests use a deterministic mock unless GEMINI_API_KEY is set.
# Production refuses AI calls unless GEMINI_API_KEY is set AND GEMINI_TIER=paid (free-tier prompts
# can be used by Google to improve models; not acceptable for school data).
GEMINI_API_KEY=
GEMINI_TIER=               # must be "paid" in production
AI_RATE_PER_MINUTE=20

# --- Messaging (blocked on Atif: provider + approved templates). Mock by default. ------------
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=AutoEd OS <no-reply@example.com>

# --- Push (blocked on Atif: Expo + Firebase/APNs accounts) -----------------------------------
PUSH_PROVIDER=            # "expo" to send for real; empty = mock
EXPO_ACCESS_TOKEN=

# --- Misc -------------------------------------------------------------------------------------
APP_URL=http://localhost:3000
SESSION_TTL_SECONDS=1209600        # 14 days
STORAGE_DIR=./.storage
SENTRY_DSN=                # blocked on Atif: Sentry project
# Mobile (mobile/.env): EXPO_PUBLIC_API_BASE, EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_ANON_KEY
