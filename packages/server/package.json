{
  "name": "@autoed/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./api": "./src/api/index.ts",
    "./platform-admin": "./src/platform-admin/index.ts",
    "./custom-records": "./src/custom-records/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "lint": "eslint src --max-warnings 0",
    "seed": "tsx src/seed/run.ts",
    "test:platform": "vitest run -c vitest.platform.config.ts"
  },
  "dependencies": {
    "@autoed/shared": "workspace:*",
    "docx": "9.1.0",
    "exceljs": "4.4.0",
    "jose": "5.9.6",
    "pg": "8.13.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "eslint": "9.17.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.8"
  }
}
